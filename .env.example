# ===========================================
# AI Worker - 模型与搜索配置
# 复制此文件为 .env 并填入你的配置
# ===========================================
#
# 使用方式：设置 LLM_PROVIDER 选择模型提供方，然后配置对应参数。
# 不设置 LLM_PROVIDER 时会自动检测已填写的配置。

# =========================================
# 1️⃣ 本地模型 - Ollama（免费，无需 API Key）
# =========================================
# 前置条件：先安装并启动 Ollama，然后拉取模型
#   ollama serve
#   ollama pull qwen3
#
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3
# OLLAMA_HOST=http://localhost:11434

# =========================================
# 2️⃣ 阿里云 DashScope - 通义千问（云端）
# =========================================
# 获取 Key: https://dashscope.console.aliyun.com/
#
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_MODEL=qwen-max

# =========================================
# 3️⃣ OpenAI / 兼容接口（云端）
# =========================================
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# =========================================
# 4️⃣ Google Gemini（云端）
# =========================================
# 获取 Key: https://aistudio.google.com/app/apikey
#
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# =========================================
# 5️⃣ DeepSeek（云端）
# =========================================
# 获取 Key: https://platform.deepseek.com/
#
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# =========================================
# 6️⃣ 自定义 OpenAI 兼容 API（任何兼容服务）
# =========================================
# 适用于：硅基流动、Groq、Together AI、Ollama OpenAI 端点 等
#
# LLM_PROVIDER=custom
# CUSTOM_API_KEY=your-api-key
# CUSTOM_MODEL=your-model-name
# CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
# CUSTOM_PROVIDER_NAME=MyProvider（可选，仅用于日志显示）

# =========================================
# 搜索引擎（可选，默认使用 DuckDuckGo 免费引擎）
# =========================================
# SEARCH_ENGINE=duckduckgo

# =========================================
# PPT 模板路径（可选，不填则使用内置模板）
# =========================================
# PPT_TEMPLATE_PATH=./templates/default.pptx
